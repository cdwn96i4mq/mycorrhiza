import mycorrhiza.network
import mycorrhiza.substrate.corpus
import mycorrhiza.cultivation.grower
import mycorrhiza.cultivation.schedule
import mycorrhiza.tropism.composite

DIM = 256
HEADS = 8

ImmunoFounder.dim = %DIM
ImmunoFounder.depth = 12
ImmunoFounder.heads = %HEADS
ImmunoFounder.hidden = 1024
ImmunoFounder.experts = 8
ImmunoFounder.top_k = 2
ImmunoFounder.use_cross = True
ImmunoFounder.use_spatial = True
ImmunoFounder.use_rope = True
ImmunoFounder.block_cross = False

synthetic_corpus.n_sc = 128
synthetic_corpus.n_sp = 144
synthetic_corpus.n_genes = 64
synthetic_corpus.n_types = 5
synthetic_corpus.mask_ratio = 0.30
synthetic_corpus.neighbours = 6
synthetic_corpus.r_min = 0.6
synthetic_corpus.seed = 0

composite_loss.lam_align = 0.5
composite_loss.lam_spatial = 0.3
composite_loss.use_mask = True
composite_loss.tau = 0.3

Grower.lr = 5e-5
Grower.weight_decay = 0.01
Grower.betas = (0.9, 0.999)
Grower.warmup_steps = 2000
Grower.max_steps = 100000
Grower.grad_accum = 8
Grower.amp = False
Grower.seed = 0
Grower.device = "cpu"
Grower.ckpt_dir = "runs"
